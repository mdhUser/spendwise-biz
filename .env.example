# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_APP_PASSWORD=change-me-app
MYSQL_MIGRATOR_PASSWORD=change-me-migrator

# Application
BIZ_INVITE_PEPPER=replace-with-at-least-32-characters
BIZ_REGISTRATION_MODE=invite
BIZ_HTTP_ADDR=127.0.0.1:8080
BIZ_TIMEZONE=Asia/Shanghai
BIZ_LOG_LEVEL=info

# Local `go run` DSN (Docker Compose overrides this with the db hostname)
BIZ_MYSQL_DSN=biz_app:change-me-app@tcp(127.0.0.1:3306)/spendwise_biz?parseTime=true&loc=UTC
# Separate migration account (required for DDL after db/init/01-users.sh revokes DDL from biz_app)
BIZ_MIGRATION_DSN=biz_migrator:change-me-migrator@tcp(127.0.0.1:3306)/spendwise_biz?parseTime=true&loc=UTC
