# MySQL. spendwise-auth and spendwise-biz share the same `spendwise` database.
# The canonical local stack is compose.integration.yaml (MySQL on 3307).
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_APP_PASSWORD=change-me-app
MYSQL_MIGRATOR_PASSWORD=change-me-migrator

# Application
BIZ_HTTP_ADDR=127.0.0.1:8080
BIZ_TIMEZONE=Asia/Shanghai
BIZ_LOG_LEVEL=info

# spendwise-auth is the only identity provider. M0 verifies Ed25519 JWTs
# locally against the cached JWKS; GET /v1/auth/me is only a compatibility
# fallback when local verification fails.
BIZ_AUTH_BASE_URL=http://127.0.0.1:8081
BIZ_AUTH_TIMEOUT=5s
BIZ_AUTH_JWKS_URL=http://127.0.0.1:8081/v1/auth/jwks
BIZ_AUTH_ISSUER=spendwise-auth
BIZ_AUTH_AUDIENCE=spendwise-api
BIZ_AUTH_JWKS_CACHE_TTL=5m
# Optional embedded fallback public key (base64). Keep it identical to the
# active auth signing key so an api restart during an auth outage can still
# verify already-issued tokens. No private key ever belongs in biz.
BIZ_AUTH_JWKS_STATIC_PUBLIC_KEY=
BIZ_AUTH_JWKS_STATIC_KEY_ID=
# Browser cookie names. Auth strips __Host- in non-Secure local mode, so biz
# accepts both the strict and plain name.
BIZ_AUTH_COOKIE_NAME=__Host-sw_at
BIZ_AUTH_PLAIN_COOKIE_NAME=sw_at

# Local `go run` DSN (Docker Compose overrides this with the db hostname)
BIZ_MYSQL_DSN=biz_app:change-me-app@tcp(127.0.0.1:3307)/spendwise?parseTime=true&loc=UTC
# Separate migration account (required for DDL after db/init/01-users.sh revokes DDL from biz_app)
BIZ_MIGRATION_DSN=biz_migrator:change-me-migrator@tcp(127.0.0.1:3307)/spendwise?parseTime=true&loc=UTC

# M3 worker / async jobs. The worker only needs MySQL; AUTH_BASE_URL is kept
# because config validation is shared with the api process.
BIZ_WORKER_ID=worker-local
BIZ_WORKER_POLL=500ms
BIZ_WORKER_HEARTBEAT=30s
BIZ_RUN_TIMEOUT=60s
BIZ_PROVIDER_TIMEOUT=8s
BIZ_LLM_TOTAL_TIMEOUT=12s
BIZ_LLM_ATTEMPT_TIMEOUT=5s
# 0 means unlimited locally; set a daily cap in production.
BIZ_LLM_DAILY_BUDGET_FEN=0

# M4 PostgreSQL -> MySQL import (dry-run by default). Only rebuildable demo
# catalog rows (products/offers) are imported; anonymous users, conversations
# and messages are intentionally not migrated.
IMPORT_PG_DSN=postgresql://postgres:postgres@127.0.0.1:5432/spendwise
