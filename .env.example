# MySQL. spendwise-auth and spendwise-biz share the same `spendwise` database
# in production; local compose files use separate MySQL instances by default.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_APP_PASSWORD=change-me-app
MYSQL_MIGRATOR_PASSWORD=change-me-migrator

# Application
BIZ_HTTP_ADDR=127.0.0.1:8080
BIZ_TIMEZONE=Asia/Shanghai
BIZ_LOG_LEVEL=info

# spendwise-auth is the only identity provider. Biz validates bearer tokens by
# calling GET {BIZ_AUTH_BASE_URL}/v1/auth/me.
BIZ_AUTH_BASE_URL=http://127.0.0.1:8081
BIZ_AUTH_TIMEOUT=5s

# Local `go run` DSN (Docker Compose overrides this with the db hostname)
BIZ_MYSQL_DSN=biz_app:change-me-app@tcp(127.0.0.1:3306)/spendwise?parseTime=true&loc=UTC
# Separate migration account (required for DDL after db/init/01-users.sh revokes DDL from biz_app)
BIZ_MIGRATION_DSN=biz_migrator:change-me-migrator@tcp(127.0.0.1:3306)/spendwise?parseTime=true&loc=UTC
